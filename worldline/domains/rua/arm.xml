<mujoco model="worldline-planar-arm">
  <option timestep="0.002" gravity="0 0 0" integrator="implicitfast"/>
  <visual><global offwidth="256" offheight="256"/></visual>
  <default>
    <joint damping="2" armature="0.05"/>
    <geom type="capsule" size="0.025" density="600" rgba="0.25 0.5 0.85 1"/>
  </default>
  <worldbody>
    <light pos="0 0 3"/>
    <camera name="top" pos="0 0 2" xyaxes="1 0 0 0 1 0"/>
    <geom type="plane" size="1 1 0.1" rgba="0.9 0.9 0.9 1"/>
    <body name="arm" pos="0 0 0.1">
      <joint name="shoulder" type="hinge" axis="0 0 1"/>
      <geom fromto="0 0 0 0.4 0 0"/>
      <body name="forearm" pos="0.4 0 0">
        <joint name="elbow" type="hinge" axis="0 0 1"/>
        <geom fromto="0 0 0 0.3 0 0"/>
        <site name="tip" pos="0.3 0 0" size="0.035" rgba="1 0.3 0.2 1"/>
      </body>
    </body>
    <body name="target" mocap="true" pos="0.4 0.25 0.1">
      <geom type="sphere" size="0.035" contype="0" conaffinity="0" rgba="0.2 0.8 0.2 0.7"/>
    </body>
  </worldbody>
  <actuator>
    <position name="shoulder_target" joint="shoulder" kp="80" ctrlrange="-3.14159 3.14159"/>
    <position name="elbow_target" joint="elbow" kp="80" ctrlrange="-3.14159 3.14159"/>
  </actuator>
</mujoco>
